# Netlify headers file — place this at your site root (same level as index.html)
# Fixes the "Use efficient cache lifetimes" PageSpeed warning by giving
# long-lived caching to your own static assets.

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Note: the specific request PageSpeed flagged, /scripts/hud?variant=public,
# is injected automatically by Netlify on *.netlify.app subdomains (not part
# of your own source). It isn't addressable via _headers rules and will stop
# appearing once you move to a custom domain instead of the netlify.app one.
